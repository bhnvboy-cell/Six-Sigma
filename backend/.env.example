FLASK_SECRET_KEY=replace-with-a-long-random-value
FLASK_DEBUG=0
API_HOST=127.0.0.1
API_PORT=5000

SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER=.\SQLEXPRESS
SQL_DATABASE=LeanSixSigmaTraining
SQL_TRUSTED_CONNECTION=yes
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes
SQL_CONNECT_TIMEOUT=5

FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080

SESSION_COOKIE_SECURE=no
SESSION_COOKIE_SAMESITE=Lax
SESSION_HOURS=24
EXAM_PASS_PERCENT=70
MAX_UPLOAD_MB=10
